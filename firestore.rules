rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName']) &&
             data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    function isValidWatchlistItem(data) {
      return data.keys().hasAll(['movieId', 'title']) &&
             data.keys().hasOnly(['movieId', 'title', 'posterUrl', 'year', 'rating', 'addedAt']) &&
             data.movieId is string && data.movieId.size() > 0 && data.movieId.size() <= 64 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 500)) &&
             (!('year' in data) || (data.year is number)) &&
             (!('rating' in data) || (data.rating is number)) &&
             (!('addedAt' in data) || (data.addedAt is string && data.addedAt.size() <= 60));
    }

    // User profile documents
    match /users/{userId}/profile/{docId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // User watchlist subcollection
    match /users/{userId}/watchlist/{movieId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(movieId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(movieId) &&
                    incoming().movieId == movieId && isValidWatchlistItem(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidId(movieId) &&
                    incoming().movieId == existing().movieId && isValidWatchlistItem(incoming());
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(movieId);
    }

    // Movies collection for public reading & admin writing
    match /movies/{movieId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // News & dispatches collection for public reading & admin writing
    match /news/{newsId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }
  }
}
